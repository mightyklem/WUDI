# Local dev — copy to .env.local (gitignored). Do not commit secrets.
DATABASE_URL=postgresql://learnovize:learnovize@localhost:5432/learnovize
JWT_SECRET=dev-only-change-me-in-production-min-32-chars
# LiveKit (must match docker-compose LIVEKIT_KEYS)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Public URL of this web app (webhook receiver + invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Storage: S3Mock locally (path-style). Staging/prod = Cloudflare R2 (verified 2026-10-04):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BUCKET=learnovize-public
# S3_PRIVATE_BUCKET=learnovize-private
# S3_ACCESS_KEY=<r2-key-id>
# S3_SECRET_KEY=<r2-secret>
# S3_REGION=auto
# Public file CDN base (r2.dev for staging, custom domain in prod):
# PUBLIC_FILES_BASE=https://pub-<id>.r2.dev
# Payments: mock locally; set paystack + keys for real money
PAYMENTS_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
PAYOUT_HOLD_DAYS=7
