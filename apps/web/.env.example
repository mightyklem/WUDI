# Local dev — copy to .env.local (gitignored). Do not commit secrets.
DATABASE_URL=postgresql://learnovize:learnovize@localhost:5432/learnovize
JWT_SECRET=dev-only-change-me-in-production-min-32-chars
# LiveKit (must match docker-compose LIVEKIT_KEYS)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Public URL of this web app (webhook receiver + invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
