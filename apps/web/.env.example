# Local dev — copy to .env.local (gitignored). Do not commit secrets.
DATABASE_URL=postgresql://learnovize:learnovize@localhost:5432/learnovize
JWT_SECRET=dev-only-change-me-in-production-min-32-chars
# LiveKit (must match docker-compose LIVEKIT_KEYS)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Public URL of this web app (webhook receiver + invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Storage: S3Mock locally (path-style). Staging/prod = Cloudflare R2 (verified 2026-10-04):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BUCKET=learnovize-public
# S3_PRIVATE_BUCKET=learnovize-private
# S3_ACCESS_KEY=<r2-key-id>
# S3_SECRET_KEY=<r2-secret>
# S3_REGION=auto
# Public file CDN base (r2.dev for staging, custom domain in prod):
# PUBLIC_FILES_BASE=https://pub-<id>.r2.dev
# Payments: mock locally; set paystack + keys for real money
PAYMENTS_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
# Paystack API origin override — localhost only, for exercising the paid-webhook path
# against a stub. Never set in staging/prod (rejected unless it points at 127.0.0.1).
# PAYSTACK_API_BASE=http://127.0.0.1:3111
PAYOUT_HOLD_DAYS=7
# Push notifications (Expo). EXPO_ACCESS_TOKEN comes from expo.dev -> your account ->
# Access Tokens. EXPO_PROJECT_ID must match extra.eas.projectId in apps/mobile/app.json,
# or devices cannot register a working token.
# EXPO_ACCESS_TOKEN=
# EXPO_PROJECT_ID=
# Expo API origin override — localhost only, for testing send/prune/receipts without a
# device. Rejected unless it points at 127.0.0.1.
# EXPO_API_BASE=http://127.0.0.1:3112
# Slack alerts: a single incoming webhook for moderation spikes and payout releases.
# Create at api.slack.com/messaging/webhooks. Without this, alerts are silently dropped.
# SLACK_WEBHOOK_URL=
# Transactional SMS/WhatsApp (Termii). Without these, no text is sent. TERMII_WHATSAPP=true
# sends over WhatsApp too; TERMII_API_BASE only for loopback stubs.
# TERMII_API_KEY=
# TERMII_SENDER_ID=Learnovize
# TERMII_WHATSAPP=false
# TERMII_API_BASE=https://api.ng.termii.com
# Transactional email (Resend). Without both values, email is skipped entirely and only
# in-app notifications are stored. EMAIL_FROM must be a domain you verified with Resend
# (e.g. "Learnovize <no-reply@yourdomain.ng>") or mail lands in spam.
# RESEND_API_KEY=
# EMAIL_FROM=Learnovize <no-reply@yourdomain.ng>
