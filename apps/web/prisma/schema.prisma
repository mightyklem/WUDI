// Learnovize data model v1 — hardened per ADR-006.
// DB: Postgres 16 locally (docker compose), managed Postgres in cloud.
//
// This schema lives INSIDE apps/web rather than at the repo root on purpose. The Prisma CLI
// resolves `@prisma/client` relative to the schema's own directory, and under pnpm's isolated
// layout a workspace root with no dependencies exposes nothing to resolve. With the schema at
// the root, `prisma generate` worked on Windows but failed on Linux (Netlify) with
// "Could not resolve @prisma/client". Co-locating it with the package that declares both
// `prisma` and `@prisma/client` makes generation deterministic on every platform.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  suspended    Boolean  @default(false)
  // Learnovize's own content team. Verified accounts can publish ecards, videos and
  // info to Explore and are badged as official (FR-12).
  isOfficial   Boolean  @default(false)
  // Points and level rank. Attendance awards points on free and paid classes alike (FR-13).
  points       Int      @default(0)
  // Cached mirror of rankFor(points). The ladder is Stone/Bronze/Silver/Gold,
  // so the default must match rankFor(0) — anything else shows a rank that
  // does not exist in the ladder. Read rankFor() where correctness matters.
  rank         String   @default("Stone")
  // Email ownership proof (ADR-002). Null hash = nothing pending; null verifiedAt = unverified.
  emailVerifiedAt   DateTime?
  emailOtpHash      String?
  emailOtpExpiresAt DateTime?
  emailOtpAttempts  Int       @default(0)
  // Set when the person exercised their NDPA erasure right. The row is kept rather
  // than deleted because payment and payout records have a statutory retention period
  // and must not vanish with the identity. Everything that identifies a human is
  // replaced; what remains is a pseudonymous counterparty in the ledger.
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  trainerProfile TrainerProfile?
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  registrations  Registration[]
  attendanceLogs AttendanceLog[]
  certificates   Certificate[]
  moderating     Moderator[]
  auditActs      AuditLog[]      @relation("AuditActor")
  notifications  Notification[]
  pushTokens     PushToken[]
  pointEvents    PointsEvent[]
  orgMemberships OrgMember[]
  ownedOrgs      Organization[]     @relation("OrgOwner")
  authoredPosts  FeedPost[]         @relation("PostAuthor")
}

/// One award or clawback of points. Append-only so a rank can always be re-derived.
///
/// `ref` is the natural key of whatever earned the points — the session id for
/// attendance, the training id for finishing a program or earning a certificate.
/// Uniqueness is enforced on (userId, ref) rather than on sessionId, because a
/// null sessionId is distinct from every other null in Postgres, so a constraint
/// built on it would silently allow duplicate program-completion awards.
model PointsEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String   // session_attended|program_completed|certificate_earned|manual_adjustment
  ref       String   // session id, or training id for program/certificate awards
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainingId String?
  training  Training? @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  dayId     String?
  day       TrainingDay? @relation(fields: [dayId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, ref])
  @@index([userId, createdAt])
}

/// Institutions and organizations with an official verified account. They can host
/// trainings themselves and can also sponsor individual trainer profiles (FR-12).
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String   @default("organization") // institution|organization
  about        String?
  logoUrl      String?
  website      String?
  // Verification is granted by an admin, never self-declared.
  verification String   @default("pending") // pending|verified|rejected|revoked
  verifiedAt   DateTime?
  verifiedById String?
  ownerId      String
  owner        User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  members    OrgMember[]
  trainings  Training[]
  trainers   TrainerProfile[]
  posts      FeedPost[]
  approvals  OrganizationApproval[]
}

model OrgMember {
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String       @default("member") // owner|admin|trainer|member
  createdAt DateTime    @default(now())

  @@id([orgId, userId])
}

model OrganizationApproval {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docUrls        String[]
  status         String   @default("pending") // pending|verified|rejected|revoked
  reviewerId     String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A single-use password reset, requested by someone who can no longer log in.
///
/// This exists because there was no reset route at all: anyone who forgot their
/// password was permanently locked out, despite the architecture decision promising
/// "password reset via OTP". Only the SHA-256 of the token is stored, so a database
/// leak does not hand out account takeovers. A used row is retained rather than
/// deleted, so a replay is recognisably a replay rather than an unknown token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TrainerProfile {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  photoUrl          String?
  bio               String?
  topics            String[]
  logoUrl           String?
  signatureUrl      String?
paidCertApproved  Boolean @default(false)
  approvalState     String  @default("none") // none|pending|approved|rejected|revoked
  rejectionReason   String?
  plan              String  @default("free") // free|pro|business — drives caps + commission
  // An institution can verify and sponsor an individual trainer (FR-12).
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])

  approvals TrainerApproval[]
  trainings Training[]
}

model TrainerApproval {
  id                String   @id @default(cuid())
  trainerId         String
  trainer           TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Cascade)
  idDocUrls         String[] // private bucket only, never public
  expertiseEvidence String?
  // When the trainer agreed to us storing their identity document, and which wording
  // they agreed to. Without this there is no artifact proving consent was ever
  // obtained -- the form collected no checkbox and nothing was recorded. Versioned so
  // a change to the wording later can be shown to have been consented to separately.
  consentAt         DateTime?
  consentVersion    String?
  status            String   @default("pending") // pending|approved|rejected|revoked
  reviewerId        String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())
}

model Moderator {
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   @default("invited") // invited|active|removed

  @@id([trainingId, userId])
}

model Training {
  id         String   @id @default(cuid())
  slug       String   @unique
  trainerId  String
  trainer    TrainerProfile @relation(fields: [trainerId], references: [userId])
  // An organization can host a training directly, alongside the named trainer (FR-12).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  title      String
  description String?
  topic      String?
  format     String   // video|audio
  // Free classes never issue a certificate. A certificate means paid attendance (FR-11).
  accessType String   @default("free") // free|paid
  tier       String?  // basic|standard|premium — required when accessType is paid
  pricePerDayNgn Int? // whole naira, charged per billable day
  certMode   String   @default("none") // none|paid
  certPriceNgn Int?
  minPct     Int      @default(80)
  cap        Int
  seatsTaken Int      @default(0)
  plan       String   @default("free") // free|pro|business
  status     String   @default("draft") // draft|live|full|cancelled|finished
  createdAt  DateTime @default(now())

  sessions      Session[]
  days          TrainingDay[]
  registrations Registration[]
  moderators    Moderator[]
  feedPosts     FeedPost[]
  certificates  Certificate[]
  payouts       Payout[]
  pointEvents   PointsEvent[]

  @@index([accessType, tier])
}

/// One billable, selectable day of a training (FR-11). A day is what learners
/// actually buy, so price and free/paid live here rather than on the training.
/// `topic` is the human label for the day ("Battery storage").
model TrainingDay {
  id         String   @id @default(cuid())
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  dayIndex   Int      // 1-based display order
  dateUtc    String   // YYYY-MM-DD, the day this covers
  topic      String?
  // A trainer can open a single day of an otherwise paid class for free.
  accessType String   @default("paid") // free|paid
  priceNgn   Int      @default(0)

  sessions   Session[]
  enrollments DayEnrollment[]
  pointEvents PointsEvent[]

  @@unique([trainingId, dayIndex])
  @@index([trainingId, dateUtc])
}

/// A learner's choice to attend specific days of a training. Price is snapshotted
/// so a later trainer change cannot alter what they already owe.
model DayEnrollment {
  id             String   @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  dayId          String
  day            TrainingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  priceNgn       Int      @default(0)
  paid           Boolean  @default(false)

  @@unique([registrationId, dayId])
  @@index([dayId])
}

model Session {
  id          String   @id @default(cuid())
  trainingId  String
  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  dayId       String?
  day         TrainingDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)
  startsAtUtc DateTime
  endsAtUtc   DateTime
  livekitRoom String   @unique
  status      String   @default("scheduled") // scheduled|live|ended|cancelled

  attendanceLogs AttendanceLog[]
  pointEvents    PointsEvent[]
}

model Registration {
  id                String   @id @default(cuid())
  trainingId        String
  training          Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  certConsentPublic Boolean  @default(false)
  // Set when the participant has paid for the class. On a paid class this covers
  // attendance AND the certificate, so it gates certificate eligibility (FR-11).
  certPaid          Boolean  @default(false)
  // Snapshot of the quote taken when they registered. A later price change by the
  // trainer must not alter what this participant already owes.
  quotedPricePerDayNgn Int?
  quotedDays           Int?
  quotedTotalNgn       Int?
  status            String   @default("active") // active|cancelled
  createdAt         DateTime @default(now())

  payments Payment[]
  dayEnrollments DayEnrollment[]

  @@unique([trainingId, userId])
  @@index([trainingId, status])
}

model AttendanceLog {
  id               String    @id @default(cuid())
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt         DateTime?
  leftAt           DateTime?
  stayedMs         Int       @default(0)
  present          Boolean   @default(false)
  correctedBy      String?
  correctionReason String?

  @@unique([sessionId, userId])
  @@index([userId, sessionId])
}

model Certificate {
  id          String   @id @default(cuid())
  number      String   @unique // LEARNOVIZE-YYYY-XXXXXX, validated in app
  trainingId  String
  training    Training @relation(fields: [trainingId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  // A partial-attendance certificate must say what it covers, otherwise a
  // one-day certificate is indistinguishable from the full program.
  scopeLabel  String   // e.g. "Days 1–2: Battery storage" or "Full program"
  dayIds      String[] // the days actually attended
  pctAttended Int      @default(0)
  pdfUrl      String
  imageUrl    String?
  sha256      String
  status      String   @default("valid") // valid|revoked
  revokedReason String?
  createdAt   DateTime @default(now())
}

model Payment {
  id             String   @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  provider       String   // paystack|flutterwave
  providerRef    String   @unique
  accessCode     String?  // Paystack hosted-checkout code — lets an abandoned checkout resume the same transaction
  amountNgn      Int
  providerFeeNgn Int      @default(0)
  commissionNgn  Int      @default(0)
  netNgn         Int      @default(0)
  status         String   @default("pending") // pending|paid|refunded|failed
  idempotencyKey String   @unique
  rawWebhook     Json?
  createdAt      DateTime @default(now())

  @@index([providerRef, idempotencyKey])
}

model Payout {
  id         String   @id @default(cuid())
  trainerId  String
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id])
  amountNet  Int
  status     String   @default("pending") // pending|held|paid|failed
  holdUntil  DateTime?
  createdAt  DateTime @default(now())
}

model FeedPost {
  id            String   @id @default(cuid())
  // Nullable: official ecards, videos, info and announcements are not tied to a class.
  trainingId    String?
  training      Training? @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  type          String   // video|ecard|infographic
  // What this post is: a trainer's class promo, an official announcement, or a paid ad.
  kind          String   @default("training") // training|official|announcement|ad
  // Official accounts publish here and get the verified badge.
  authorId      String?
  author        User?    @relation("PostAuthor", fields: [authorId], references: [id])
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  title         String?
  body          String?
  mediaUrl      String
  thumbUrl      String?
  // An ad promotes a specific organization or individual trainer.
  isAd          Boolean  @default(false)
  adTargetType  String?  // organization|trainer
  adTargetId    String?
  adStartsAt    DateTime?
  adEndsAt      DateTime?
  status        String   @default("live") // live|hidden|removed
  reportsCount  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([kind, status, createdAt])
}

model Follow {
  followerId String
  trainerId  String

  @@id([followerId, trainerId])
}

model Save {
  userId     String
  trainingId String

  @@id([userId, trainingId])
}

model Like {
  userId String
  postId String

  @@id([userId, postId])
}

model Report {
  id         String   @id @default(cuid())
  targetType String   // post|trainer|certificate
  targetId   String
  reporterId String
  reason     String
  status     String   @default("open") // open|actioned|dismissed
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  target    String
  reason    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("unknown") // ios|android|web
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerifyVisit {
  id        String   @id @default(cuid())
  number    String
  status    String // valid|revoked|not-found
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([number])
}
