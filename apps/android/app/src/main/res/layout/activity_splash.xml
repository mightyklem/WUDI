<?xml version="1.0" encoding="utf-8"?>
<!--
  The held launch screen. Teal, the mark, the wordmark.

  Small and close together on purpose. The brief was a welcoming lockup rather
  than a title screen, so the group reads as one compact badge in the middle of
  the teal instead of two large elements competing for attention.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/splashBackground"
    android:fitsSystemWindows="true">

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/splash_icon"
        android:contentDescription="@null"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/splash_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:letterSpacing="-0.02"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/splash_tagline"
        android:textColor="#D8ECF0"
        android:textSize="12.5sp"
        android:letterSpacing="0.06"
        android:includeFontPadding="false" />

</LinearLayout>