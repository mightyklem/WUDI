<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen: the Learnovize mark with the wordmark under it, on the brand
  teal, held briefly before the app appears.

  Only two things on it. The tagline that sat here first made the lockup read as
  a title card rather than a mark, and the brief was the symbol and the name.

  Manrope is the same face the web app uses, bundled as a TrueType variable font.
  Android has no way to reach a variable axis from a layout, so it renders at its
  default instance; the weight is set in code with a synthetic bold, which is what
  the site uses for the wordmark anyway.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/splashBackground"
    android:fitsSystemWindows="true">

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/splash_icon"
        android:contentDescription="@null"
        android:layout_marginBottom="13dp" />

    <TextView
        android:id="@+id/splash_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:fontFamily="@font/manrope"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false" />

</LinearLayout>