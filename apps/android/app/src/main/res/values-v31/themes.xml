<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31+) SplashScreen API. Without this a modern phone shows a
  flat colour with no mark, which reads as a crash rather than a launch.

  Deliberately no statusBarColor or navigationBarColor; see the note in
  res/values/themes.xml. Defining them here crashed the app on launch.

  The versioned qualifier keeps these attributes out of older builds, which do
  not know them.
The teal is deliberate. The splash icon is the white play mark, so a teal
  background plus a white mark reproduces the Learnovize logo at launch scale.
  Against the previous near-white background the white play was very nearly
  invisible, which is the opposite of what a splash is for.

  Icon background is set to the same teal so no disc is drawn behind the mark.
-->
<resources>
    <style name="Theme.Learnovize" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splashBackground</item>
    </style>

    <style name="Theme.Learnovize.Launcher" parent="Theme.Learnovize">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>