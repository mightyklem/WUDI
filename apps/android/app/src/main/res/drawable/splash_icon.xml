<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon for Android 12+.

  Deliberately a plain VectorDrawable rather than the adaptive launcher icon.

  windowSplashScreenAnimatedIcon takes a drawable. Handing it an adaptive icon,
  or one of its layers, is a documented source of a crash on launch on Android 12
  builds. It also scales wrong: an adaptive foreground is a 108dp canvas with the
  artwork inside a 72dp safe zone, so on the splash it renders tiny inside a
  240dp circle.

  The teal disc behind it comes from windowSplashScreenIconBackgroundColor, so
  this file is only the white play mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8,5 L19,12 L8,19 Z" />
</vector>