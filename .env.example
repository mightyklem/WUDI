# Local defaults. Copy to .env (gitignored) for real secrets.
DATABASE_URL=postgresql://wudi:wudi@localhost:5432/wudi
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BUCKET=wudi-public
S3_PRIVATE_BUCKET=wudi-private
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
