# Local defaults. Copy to .env (gitignored) for real secrets.
DATABASE_URL=postgresql://learnovize:learnovize@localhost:5432/learnovize
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BUCKET=learnovize-public
S3_PRIVATE_BUCKET=learnovize-private
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
# LiveKit (local Docker --dev; cloud uses real keys + coturn)
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret
