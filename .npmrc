# pnpm isolates packages by default, so @prisma/client and the prisma CLI are only
# linked inside apps/web/node_modules. `prisma generate` resolves @prisma/client
# upward from prisma/schema.prisma (repo root, outside any workspace package) and
# fails with "Could not resolve @prisma/client". Hoist Prisma's packages to the
# virtual store's public root so they are resolvable repo-wide.
# Defaults are repeated explicitly because setting public-hoist-pattern overrides them.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma*
