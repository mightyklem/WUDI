node_modules/
.env
*.local
.next/
dist/
*.log
apps/web/generated/
.netlify/
# Local disk storage driver: uploaded media and rendered e-cards. Real uploads live in
# R2/S3, so nothing here belongs in version control.
.local-storage/
# tsc incremental build info
tsconfig.tsbuildinfo
# Android signing material must never be committed. Release builds read the
# keystore from GitHub Actions secrets (ANDROID_KEYSTORE_BASE64 and friends);
# local debug keystores and Gradle outputs stay out of version control too.
*.jks
*.keystore

# The one-time output of apps/android/setup-signing.ps1. It holds the four
# signing secrets in plain text so they can be copied into GitHub Actions
# without being pasted into a chat window. It must never be committed.
android-signing-secrets.txt
**/android-signing-secrets.txt
apps/android/local.properties
apps/android/.gradle/
apps/android/build/
apps/android/app/build/

# Certificate signing keypair (Ed25519), written here so it can be copied into Netlify.
# The private half must never be committed or pasted anywhere -- losing it means nothing
# new can ever be signed. Back it up offline.
apps/web/cert-signing-secrets.txt
